---
interface Props {
  href: string;
  title: string;
  description: string;
  gradient: [string, string];
  badge?: string;
}

const { href, title, description, gradient, badge } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
>
  <div
    class="flex h-32 items-end p-4"
    style={`background: linear-gradient(135deg, ${gradient[0]}, ${gradient[1]});`}
  >
    {badge && (
      <span class="rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-indigo-950">{badge}</span>
    )}
  </div>
  <div class="flex flex-1 flex-col gap-2 p-5">
    <h3 class="font-serif text-lg font-bold text-indigo-950 group-hover:text-sakura-600">{title}</h3>
    <p class="text-sm text-slate-600 line-clamp-3">{description}</p>
  </div>
</a>
