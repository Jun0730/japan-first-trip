---
import { SITE_TITLE, NAV_LINKS } from '../consts';
---

<header class="border-b border-slate-200 bg-white/90 backdrop-blur sticky top-0 z-50">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6">
    <a href="/" class="font-serif text-xl font-bold tracking-tight text-indigo-950">
      {SITE_TITLE}
    </a>

    <nav class="hidden gap-6 md:flex">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-slate-600 transition hover:text-sakura-600"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <details class="relative md:hidden">
      <summary class="cursor-pointer list-none rounded border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700">
        Menu
      </summary>
      <div class="absolute right-0 mt-2 flex w-48 flex-col gap-1 rounded-lg border border-slate-200 bg-white p-3 shadow-lg">
        {
          NAV_LINKS.map((link) => (
            <a href={link.href} class="rounded px-2 py-1.5 text-sm text-slate-700 hover:bg-sakura-50">
              {link.label}
            </a>
          ))
        }
      </div>
    </details>
  </div>
</header>
