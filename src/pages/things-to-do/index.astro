---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';

const activities = await getCollection('activities', ({ data }) => !data.draft);
---

<BaseLayout
  title="Things To Do in Japan"
  description="Tours, day trips and experiences across Japan worth booking ahead of time."
>
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <h1 class="font-serif text-3xl font-bold text-indigo-950 sm:text-4xl">Things To Do</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      A short list of activities that are genuinely worth booking ahead instead of winging it.
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        activities.map((entry) => (
          <ContentCard
            href={`/things-to-do/${entry.slug}/`}
            title={entry.data.title}
            description={entry.data.description}
            gradient={entry.data.heroGradient}
            badge={entry.data.location}
          />
        ))
      }
    </div>
  </div>
</BaseLayout>
