---
import { getCollection, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import AffiliateButton from '../../components/AffiliateButton.astro';

export async function getStaticPaths() {
  const entries = await getCollection('hotels');
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'hotels'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  gradient={entry.data.heroGradient}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  eyebrow={`Where To Stay · ${entry.data.area}`}
  breadcrumbs={[
    { name: 'Where To Stay', url: '/where-to-stay/' },
    { name: entry.data.title, url: `/where-to-stay/${entry.slug}/` },
  ]}
>
  <div class="not-prose mb-8 rounded-xl border border-slate-200 bg-slate-50 p-5">
    {entry.data.priceHint && <p class="mb-3 text-sm text-slate-600">{entry.data.priceHint}</p>}
    <AffiliateButton href={entry.data.affiliateUrl} provider={entry.data.provider} />
  </div>

  <Content />

  <div class="not-prose mt-10">
    <AffiliateButton href={entry.data.affiliateUrl} provider={entry.data.provider} />
  </div>
</ArticleLayout>
