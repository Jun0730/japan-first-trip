---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';

const hotels = await getCollection('hotels', ({ data }) => !data.draft);
---

<BaseLayout
  title="Where To Stay in Japan"
  description="Area-by-area hotel guides for Tokyo, Kyoto, Osaka and beyond — where to base yourself depending on your trip style."
>
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <h1 class="font-serif text-3xl font-bold text-indigo-950 sm:text-4xl">Where To Stay</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Which neighborhood to book depends on what you're prioritizing — here's how to choose.
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        hotels.map((entry) => (
          <ContentCard
            href={`/where-to-stay/${entry.slug}/`}
            title={entry.data.title}
            description={entry.data.description}
            gradient={entry.data.heroGradient}
            badge={entry.data.area}
          />
        ))
      }
    </div>
  </div>
</BaseLayout>
