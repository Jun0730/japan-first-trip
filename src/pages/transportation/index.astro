---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';

const transportation = await getCollection('transportation', ({ data }) => !data.draft);
---

<BaseLayout
  title="Japan Transportation Guides"
  description="JR Pass advice, airport transfers, IC cards and Shinkansen booking help for first-time visitors to Japan."
>
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <h1 class="font-serif text-3xl font-bold text-indigo-950 sm:text-4xl">Transportation</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Getting from the airport, between cities, and around town — booked ahead where it's actually worth it.
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        transportation.map((entry) => (
          <ContentCard
            href={`/transportation/${entry.slug}/`}
            title={entry.data.title}
            description={entry.data.description}
            gradient={entry.data.heroGradient}
            badge={entry.data.transportType}
          />
        ))
      }
    </div>
  </div>
</BaseLayout>
