---
import { getCollection, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('guides');
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'guides'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  gradient={entry.data.heroGradient}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  eyebrow={`Area Guide · ${entry.data.region}`}
  breadcrumbs={[
    { name: 'Area Guides', url: '/guides/' },
    { name: entry.data.title, url: `/guides/${entry.slug}/` },
  ]}
>
  <Content />
</ArticleLayout>
