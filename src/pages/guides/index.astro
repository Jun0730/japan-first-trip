---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';

const guides = await getCollection('guides', ({ data }) => !data.draft);
---

<BaseLayout
  title="Japan City Guides"
  description="Practical city-by-city guides across Japan: what each place is like, how to get there, and what to expect."
>
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <h1 class="font-serif text-3xl font-bold text-indigo-950 sm:text-4xl">Area Guides</h1>
    <p class="mt-3 max-w-2xl text-slate-600">
      Get to know each city before you go — vibe, highlights, and how to fit it into your trip.
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        guides.map((entry) => (
          <ContentCard
            href={`/guides/${entry.slug}/`}
            title={entry.data.title}
            description={entry.data.description}
            gradient={entry.data.heroGradient}
            badge={entry.data.region}
          />
        ))
      }
    </div>
  </div>
</BaseLayout>
