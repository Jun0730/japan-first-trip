---
import BaseLayout from './BaseLayout.astro';
import AffiliateDisclosureNote from '../components/AffiliateDisclosureNote.astro';

interface Props {
  title: string;
  description: string;
  gradient: [string, string];
  pubDate: Date;
  updatedDate?: Date;
  eyebrow?: string; // small label above the title, e.g. "Kyoto" or "7-Day Itinerary"
  breadcrumbs?: { name: string; url: string }[];
}

const { title, description, gradient, pubDate, updatedDate, eyebrow, breadcrumbs } = Astro.props;
const dateLabel = (updatedDate ?? pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description} pubDate={pubDate} updatedDate={updatedDate} breadcrumbs={breadcrumbs}>
  <div class="px-4 py-14 text-white sm:px-6" style={`background: linear-gradient(135deg, ${gradient[0]}, ${gradient[1]});`}>
    <div class="mx-auto max-w-3xl">
      {eyebrow && <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-white/80">{eyebrow}</p>}
      <h1 class="font-serif text-3xl font-bold sm:text-4xl">{title}</h1>
      <p class="mt-3 text-lg text-white/90">{description}</p>
      <p class="mt-4 text-xs text-white/70">Updated {dateLabel}</p>
    </div>
  </div>

  <article class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <div class="prose">
      <slot />
    </div>
    <div class="mt-10">
      <AffiliateDisclosureNote />
    </div>
  </article>
</BaseLayout>
